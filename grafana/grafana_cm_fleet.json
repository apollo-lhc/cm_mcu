{
  "title": "Apollo CM fleet",
  "uid": "apollo-cm-fleet",
  "tags": [
    "apollo",
    "cm_mcu"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Blade diagnostics",
      "type": "link",
      "url": "/d/apollo-cm-diag",
      "keepTime": true,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS",
        "label": "Graphite",
        "type": "datasource",
        "query": "graphite",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Power state",
      "description": "POWER_FAILURE red, ON green, anything else (OFF, sequencing) blue.",
      "datasource": {
        "type": "graphite",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "target": "aliasByNode(consolidateBy(shelf.00.*.CM_DIAG_PWR.PWR_STATE.VALUE, 'last'), 2)",
          "datasource": {
            "type": "graphite",
            "uid": "${DS}"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              },
              {
                "color": "green",
                "value": 10
              },
              {
                "color": "blue",
                "value": 11
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILURE",
                  "index": 0
                },
                "1": {
                  "text": "INIT",
                  "index": 1
                },
                "2": {
                  "text": "DOWN",
                  "index": 2
                },
                "3": {
                  "text": "OFF",
                  "index": 3
                },
                "4": {
                  "text": "L1ON",
                  "index": 4
                },
                "5": {
                  "text": "L2ON",
                  "index": 5
                },
                "6": {
                  "text": "L3ON",
                  "index": 6
                },
                "7": {
                  "text": "L4ON",
                  "index": 7
                },
                "8": {
                  "text": "L5ON",
                  "index": 8
                },
                "9": {
                  "text": "L6ON",
                  "index": 9
                },
                "10": {
                  "text": "ON",
                  "index": 10
                },
                "11": {
                  "text": "CONFIG",
                  "index": 11
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "Open ${__series.name}",
              "targetBlank": false,
              "url": "/d/apollo-cm-diag?var-WhichApollo=${__series.name}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      }
    },
